  "architecture": {
    "pattern": "MVVM + Async Pipeline",
    "components": {
      "Model": "CutlineService (QtConcurrent worker thread)",
      "ViewModel": "CutlineController (16ms debounce, RequestId validation)",
      "View": "DongArchCutlineRealtimeDialog + CutlineOverlayWidget",
      "Storage": "CutlineSlotManager (JSON persistence)"
    },
    "dataFlow": [
      "User Input → Controller → Debounce Timer (16ms)",
      "Timer → Service::computeAsync (QtConcurrent::run)",
      "Worker Thread: Raw → Douglas-Peucker → Catmull-Rom",
      "Service → Controller::onPolylineReady",
      "Controller → Overlay Widget → QPainter rendering"
    ]
  },
