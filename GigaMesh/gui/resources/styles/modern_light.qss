/* Modern Light Theme for GigaMesh */
/* 현대적인 라이트 테마 */

/* 메인 윈도우 */
QMainWindow {
    background-color: #f5f5f5;
    color: #333333;
}

/* 메뉴바 - 깨끗한 화이트 스타일 */
QMenuBar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:1 #f8f8f8);
    color: #333333;
    padding: 5px;
    border: none;
    border-bottom: 1px solid #e0e0e0;
}

QMenuBar::item:selected {
    background: #0078d4;
    color: white;
    border-radius: 4px;
}

/* 메뉴 드롭다운 */
QMenu {
    background-color: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 8px;
    padding: 5px;
}

QMenu::item:selected {
    background-color: #e3f2fd;
    color: #0078d4;
    border-radius: 4px;
}

/* 툴바 - Material Design 스타일 */
QToolBar {
    background: #ffffff;
    border: none;
    border-bottom: 1px solid #e0e0e0;
    spacing: 10px;
    padding: 8px;
}

QToolButton {
    background: transparent;
    border: none;
    border-radius: 6px;
    padding: 10px;
    margin: 2px;
}

QToolButton:hover {
    background: #e3f2fd;
}

QToolButton:pressed {
    background: #bbdefb;
}

/* 독 위젯 - 카드 스타일 패널 */
QDockWidget {
    background: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin: 5px;
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #fafafa, stop:1 #f5f5f5);
    padding: 10px;
    border-bottom: 2px solid #0078d4;
    font-weight: bold;
}

/* 버튼 - Material Design 스타일 */
QPushButton {
    background: #0078d4;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 14px;
}

QPushButton:hover {
    background: #106ebe;
}

QPushButton:pressed {
    background: #005a9e;
    padding: 11px 19px 9px 21px; /* 눌림 효과 */
}

QPushButton:disabled {
    background: #cccccc;
    color: #666666;
}

/* 보조 버튼 스타일 */
QPushButton[secondary="true"] {
    background: #ffffff;
    color: #0078d4;
    border: 2px solid #0078d4;
}

QPushButton[secondary="true"]:hover {
    background: #e3f2fd;
}

/* 아이콘 버튼 - 큰 사이즈 */
QPushButton#iconButton {
    min-width: 72px;
    min-height: 72px;
    border-radius: 12px;
    background: #ffffff;
    border: 2px solid #e0e0e0;
}

QPushButton#iconButton:hover {
    border: 2px solid #0078d4;
    background: #e3f2fd;
}

/* 슬라이더 - iOS 스타일 */
QSlider::groove:horizontal {
    height: 6px;
    background: #e0e0e0;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #0078d4;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    margin: -9px 0;
    border: 2px solid white;
}

QSlider::handle:horizontal:hover {
    background: #106ebe;
    width: 28px;
    height: 28px;
    margin: -11px 0;
}

QSlider::sub-page:horizontal {
    background: #0078d4;
    border-radius: 3px;
}

/* 스크롤바 - 미니멀 스타일 */
QScrollBar:vertical {
    background: #f5f5f5;
    width: 10px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #c0c0c0;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background: #0078d4;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}

/* 탭 위젯 - Chrome 스타일 탭 */
QTabWidget::pane {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 0 8px 8px 8px;
}

QTabBar::tab {
    background: #f5f5f5;
    color: #666666;
    padding: 12px 24px;
    border: none;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #ffffff;
    color: #0078d4;
    border-bottom: 3px solid #0078d4;
}

QTabBar::tab:hover:!selected {
    background: #e8e8e8;
    color: #333333;
}

/* 입력 필드 - Google Material 스타일 */
QLineEdit, QTextEdit, QPlainTextEdit {
    background: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 10px;
    font-size: 14px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #0078d4;
    outline: none;
}

/* 콤보박스 - 드롭다운 */
QComboBox {
    background: #ffffff;
    color: #333333;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    padding: 10px;
    min-width: 120px;
}

QComboBox:hover {
    border: 1px solid #0078d4;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
}

/* 리스트 위젯 */
QListWidget {
    background: #ffffff;
    color: #333333;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 5px;
}

QListWidget::item {
    padding: 12px;
    border-radius: 6px;
    border-bottom: 1px solid #f0f0f0;
}

QListWidget::item:hover {
    background: #f5f5f5;
}

QListWidget::item:selected {
    background: #e3f2fd;
    color: #0078d4;
}

/* 프로그레스바 */
QProgressBar {
    background: #e0e0e0;
    border: none;
    border-radius: 6px;
    text-align: center;
    color: #333333;
    height: 8px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
        stop:0 #4fc3f7, stop:1 #0078d4);
    border-radius: 6px;
}

/* 툴팁 */
QToolTip {
    background: #333333;
    color: #ffffff;
    border: none;
    border-radius: 6px;
    padding: 8px;
}

/* 상태바 */
QStatusBar {
    background: #fafafa;
    color: #666666;
    border-top: 1px solid #e0e0e0;
    font-size: 13px;
}

/* 그룹박스 - 카드 스타일 */
QGroupBox {
    background: #ffffff;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    margin-top: 15px;
    padding-top: 15px;
    color: #333333;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 15px;
    padding: 0 10px 0 10px;
    color: #0078d4;
    font-weight: bold;
    font-size: 14px;
}

/* 체크박스 & 라디오 버튼 - Material 스타일 */
QCheckBox, QRadioButton {
    color: #333333;
    spacing: 10px;
    font-size: 14px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 20px;
    height: 20px;
    background: #ffffff;
    border: 2px solid #999999;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 10px;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background: #0078d4;
    border: 2px solid #0078d4;
}

QCheckBox::indicator:checked {
    image: url(:/icons/check_white.png);
}

/* 다이얼로그 */
QDialog {
    background: #ffffff;
    color: #333333;
}

/* 스플리터 */
QSplitter::handle {
    background: #e0e0e0;
    width: 2px;
}

QSplitter::handle:hover {
    background: #0078d4;
    width: 4px;
}