# DongArch3D Studio — Git 줄바꿈(EOL) 및 바이너리 속성 정규화
# 기본 텍스트 자동 감지 및 LF 정규화 (LF will be replaced by CRLF 경고 방지)
* text=auto eol=lf

# C++ / CMake / 문서는 항상 LF 유지
*.cpp text eol=lf
*.hpp text eol=lf
*.h   text eol=lf
*.c   text eol=lf
*.cc  text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf
*.md  text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf
*.sh  text eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 3D 스캔 메시·래스터 이미지·출판 문서는 바이너리로 고정
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.ply binary
*.stl binary
*.wrl binary
*.glb binary
*.exe binary
*.dll binary
